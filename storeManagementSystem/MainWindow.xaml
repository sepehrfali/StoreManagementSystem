<Window x:Class="storeManagementSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Store Management System"
        Height="682"
        Width="1158">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="Store Management System"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <!-- Main Content -->
        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Products -->
            <GroupBox Header="Products"
                      Grid.Column="0"
                      Margin="0,0,10,0">

                <Grid Margin="10">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="ProductsDataGrid"
                              AutoGenerateColumns="True"
                              IsReadOnly="True"/>

                    <StackPanel Grid.Row="1"
            Orientation="Horizontal"
            Margin="0,10,0,0">

                        <Button Content="Refresh"
            Width="100"
            Margin="0,0,10,0"
            Click="RefreshProducts_Click"/>

                        <Button Content="Add Product"
            Width="120"
            Margin="0,0,10,0"
            Click="AddProduct_Click"/>

                        <Button Content="Edit Product"
            Width="120"
            Margin="0,0,10,0"
            Click="EditProduct_Click"/>

                        <Button Content="Delete"
            Width="100"
            Click="DeleteProduct_Click"/>

                    </StackPanel>
                </Grid>

            </GroupBox>

            <!-- Categories -->
            <GroupBox Header="Categories"
          Grid.Column="1">

                <Grid Margin="10">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListBox x:Name="CategoriesListBox"
                 DisplayMemberPath="Name"/>
                    <StackPanel Grid.Row="1"
            Orientation="Horizontal"
            Margin="0,10,0,0">

                        <Button Content="Add Category"
            Width="100"
            Height="35"
            Margin="0,0,5,0"
            Click="AddCategory_Click"/>

                        <Button Content="Edit"
            Width="65"
            Height="35"
            Margin="0,0,5,0"
            Click="EditCategory_Click"/>

                        <Button Content="Delete"
            Width="65"
            Height="35"
            Margin="0,0,5,0"
            Click="DeleteCategory_Click"/>

                        <Button Content="Refresh"
            Width="75"
            Height="35"
            Click="RefreshCategories_Click"/>

                    </StackPanel>
                </Grid>

            </GroupBox>

        </Grid>

    </Grid>

</Window>