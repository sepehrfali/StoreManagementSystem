<Window x:Class="storeManagementSystem.AddProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Product"
        Height="450"
        Width="450"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="25">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="17*"/>
            <ColumnDefinition Width="33*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Add New Product"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,20" Grid.ColumnSpan="2"/>

        <TextBlock Grid.Row="1"
                   Text="Name" Grid.ColumnSpan="2" Margin="0,0,0,50" Grid.RowSpan="2"/>

        <TextBox x:Name="NameTextBox"
                 Grid.Row="2"
                 Height="30"
                 Margin="0,5,0,15" Grid.ColumnSpan="2"/>

        <TextBlock Grid.Row="3"
                   Text="Price" Grid.ColumnSpan="2" Margin="0,0,0,50" Grid.RowSpan="2"/>

        <TextBox x:Name="PriceTextBox"
                 Grid.Row="4"
                 Height="30"
                 Margin="0,5,0,15" Grid.ColumnSpan="2"/>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2">

            <TextBlock Text="Quantity"/>

            <TextBox x:Name="QuantityTextBox"
                     Height="30"
                     Margin="0,5,0,15"/>

            <TextBlock Text="Category"/>

            <ComboBox x:Name="CategoryComboBox"
          Height="30"
          DisplayMemberPath="Name"
          Margin="0,5,0,20"/>

            <Button Content="Add Product"
                    Height="40"
                    Click="AddProduct_Click"/>

        </StackPanel>

    </Grid>

</Window>